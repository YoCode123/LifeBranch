<h2 class="mb-4">ログイン</h2>

<%= form_for(resource,
      as: resource_name,
      url: session_path(resource_name),
      data: {
        controller: "loading",
        action: "submit->loading#submit"
      }) do |f| %>

  <!-- メール -->
  <div class="mb-3">
    <%= f.label :email, "メールアドレス", class: "form-label" %>
    <%= f.email_field :email,
          class: "form-control",
          autofocus: true,
          autocomplete: "email",
          placeholder: "example@example.com" %>
  </div>

  <!-- パスワード -->
  <div class="mb-3">
    <%= f.label :password, "パスワード", class: "form-label" %>
    <%= f.password_field :password,
          class: "form-control",
          autocomplete: "current-password",
          placeholder: "パスワードを入力" %>
  </div>

  <!-- remember_me -->
  <% if devise_mapping.rememberable? %>
    <div class="form-check mb-3">

      <%= f.check_box :remember_me,
            class: "form-check-input" %>

      <%= f.label :remember_me,
            "ログイン状態を保存する",
            class: "form-check-label" %>

      <div class="form-text">
        次回ログインを省略できます
      </div>

    </div>
  <% end %>

  <!-- submit -->
  <div class="d-grid">
    <%= f.submit "ログイン",
          class: "btn btn-primary",
          data: { loading_text: "ログイン中..." } %>
  </div>

<% end %>

<!-- Google login -->

<div class="d-grid mt-3">
  <%= button_to "Googleでログイン",
        "/auth/google_oauth2",
        method: :post,
        class: "btn btn-danger",
        data: { turbo: false } %>
</div>

<!-- GitHub login -->

<div class="d-grid mt-3">
  <%= button_to "GitHubでログイン",
                "/auth/github",
                method: :post,
                class: "btn btn-dark",
                data: { turbo: false } %>
</div>

<!-- links -->
<div class="mt-3 text-center">
  <%= render "devise/shared/links" %>
</div>
